{
    "name": "craftcms/http-cache",
    "description": "HTTP cache tags, cache policy, and CDN invalidation for Craft CMS",
    "keywords": [
        "craftcms",
        "cache",
        "cdn",
        "http-cache"
    ],
    "homepage": "https://github.com/craftcms/http-cache",
    "license": "proprietary",
    "authors": [
        {
            "name": "Pixel & Tonic",
            "homepage": "https://pixelandtonic.com/"
        }
    ],
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1",
        "friendsofsymfony/http-cache": "^3.2",
        "php-http/guzzle7-adapter": "^1.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "CraftCms\\HttpCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CraftCms\\HttpCache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "fix-cs": "vendor/bin/pint",
        "ci": [
            "vendor/bin/pint --test",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CraftCms\\HttpCache\\HttpCacheServiceProvider"
            ]
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
